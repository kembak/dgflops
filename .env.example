# Preferred localhost/Vercel setup: pull the integration variables from Vercel.
# FLOPSTORAGE_TURSO_DATABASE_URL=libsql://your-database.turso.io
# FLOPSTORAGE_TURSO_AUTH_TOKEN=your-server-only-token
# For intentionally isolated offline development only (never combine with Turso):
# DG_DATABASE_MODE=local
# Optional isolated test database path:
# DG_SQLITE_PATH=data/test.sqlite
# One-time admin bootstrap uses `npm run admin:bootstrap -- ExactUsername`.
